{
  "name": "playwright-report-summary",
  "description": "A GitHub action to report Playwright test results as pull-request comments",
  "version": "3.11.0",
  "author": "step-security",
  "homepage": "https://github.com/step-security/playwright-report-comment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/playwright-report-comment.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/playwright-report-comment/issues"
  },
  "keywords": [
    "actions",
    "node",
    "testing",
    "reporting",
    "test report",
    "playwright",
    "pull request"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "jest",
    "format:write": "prettier --write '**/*.ts'",
    "format:check": "prettier --check '**/*.ts'",
    "lint": "npx eslint . --ignore-pattern rollup.config.ts --ignore-pattern jest.config.ts",
    "package": "ncc build src/index.ts --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "test": "jest",
    "test:update": "jest -u",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/github": "^8.0.0",
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^22.0.0",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.0",
    "eslint": "^8.49.0",
    "eslint-plugin-github": "^5.1.8",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
